{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Esperto",
  "version": "0.1.0",
  "identifier": "com.samuelspineli.esperto",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Esperto",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true,
        "theme": "Dark",
        "resizable": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "COLE_SUA_CHAVE_PUBLICA_AQUI",
      "endpoints": [
        "https://github.com/samuelspineli34/Esperto/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}